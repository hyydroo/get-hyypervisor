# ---- Forwarder ---------------------------------------------------------------------------------------
FWD_USER="hyyper-forwarder"; FWD_ENV_DIR="/etc/hyyper-forwarder"; FWD_DATA="/var/lib/hyyper-forwarder"
fwd_env() { [[ -f "$FWD_ENV_DIR/forwarder.env" ]] && sed -n "s/^$1=//p" "$FWD_ENV_DIR/forwarder.env" | head -1 || true; }

# hyyper-forwarder: setzt die Port-Weiterleitung (nftables-DNAT) aus dem Portal um. Läuft ohne root, nur mit CAP_NET_ADMIN.
install_forwarder() {
  [[ -n "$PORTAL_URL" ]] || ask PORTAL_URL "Adresse des Portals (z. B. http://10.0.0.5:8080)"
  PORTAL_URL="${PORTAL_URL%/}"
  [[ "$PORTAL_URL" == http* ]] || die "Portal-Adresse muss mit http:// oder https:// beginnen."
  require_secure "$PORTAL_URL"
  [[ -n "$TOKEN" ]] || ask TOKEN "Beitritts-Token (Portal → Forwarder → Forwarder anlegen)" secret
  [[ -n "$TOKEN" ]] || die "Beitritts-Token fehlt."

  say "Installiere Forwarder (hyyper-forwarder) …"
  apt_install nftables curl ca-certificates
  if ! id "$FWD_USER" >/dev/null 2>&1; then
    useradd --system --home-dir "$FWD_DATA" --create-home --shell /usr/sbin/nologin "$FWD_USER"
  fi
  mkdir -p "$FWD_DATA" "$FWD_ENV_DIR"; chown "$FWD_USER:$FWD_USER" "$FWD_DATA"; chmod 750 "$FWD_DATA"

  say "Lade hyyper-forwarder vom Portal …"
  fetch_node_binary "$PORTAL_URL" "$TOKEN"
  say "Version: $(installed_version)"
  say "Melde Forwarder beim Portal an …"
  local enroll ftoken
  enroll=$(curl -fsS -X POST -H "Authorization: Bearer $TOKEN" "$PORTAL_URL/api/forwarder/enroll") \
    || die "Beitritt abgelehnt – Token abgelaufen oder schon benutzt? Im Portal einen neuen Beitritts-Token erzeugen."
  ftoken=$(printf '%s' "$enroll" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
  [[ "$ftoken" == hyy_* ]] || die "Unerwartete Antwort vom Portal."

  umask 077
  cat > "$FWD_ENV_DIR/forwarder.env" <<ENVEOF
# hyyper-forwarder – Verbindung zum Portal (Token geheim halten)
HYY_PORTAL_URL=$PORTAL_URL
HYY_FORWARDER_TOKEN=$ftoken
HYY_FORWARDER_DATA=$FWD_DATA
ENVEOF
  umask 022
  chown root:"$FWD_USER" "$FWD_ENV_DIR/forwarder.env"; chmod 640 "$FWD_ENV_DIR/forwarder.env"

  # Weiterleiten zwischen Netzen erlauben (Gateway-Betrieb)
  printf 'net.ipv4.ip_forward=1\n' > /etc/sysctl.d/99-hyyper-forwarder.conf
  sysctl -q -p /etc/sysctl.d/99-hyyper-forwarder.conf >/dev/null || say "Hinweis: ip_forward ließ sich nicht setzen (Container ohne Rechte?)."

  cat > /etc/systemd/system/hyyper-forwarder.service <<UNITEOF
[Unit]
Description=hyyper-forwarder (hyypervisor Port-Weiterleitung)
After=network-online.target
Wants=network-online.target

[Service]
User=$FWD_USER
EnvironmentFile=$FWD_ENV_DIR/forwarder.env
ExecStart=$BIN forwarder
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=$FWD_DATA

[Install]
WantedBy=multi-user.target
UNITEOF
  systemctl daemon-reload
  systemctl enable hyyper-forwarder.service >/dev/null
  systemctl restart hyyper-forwarder.service
  sleep 2
  systemctl --no-pager --lines=5 status hyyper-forwarder.service || true
  say "Fertig. Der Forwarder sollte im Portal gleich als online erscheinen (Admin → Forwarder)."
  say "Nodes hinter diesem Forwarder: im Portal bei jedem Node die Adresse und den Forwarder eintragen; im Gateway-Modus"
  say "muss der Forwarder das Standard-Gateway dieser Nodes sein. Außenports (TCP+UDP) an der Firewall zum Forwarder leiten."
  say "Logs: journalctl -u hyyper-forwarder -f"
}

# ---- Update / Entfernen / Status -----------------------------------------------------------------
update_portal() {
  [[ -f "$PORTAL_ENV_DIR/install.conf" ]] && [[ $ARGS_GIVEN -eq 0 ]] && IMAGE=$(sed -n 's/^IMAGE=//p' "$PORTAL_ENV_DIR/install.conf")
  say "Aktualisiere Portal (bisher $(installed_version)) …"
  local tmp; tmp=$(mktemp)
  fetch_portal_binary "$tmp"
  install -m 755 "$tmp" "$BIN"; rm -f "$tmp"
  refresh_self_from_binary
  systemctl restart hyypervisor.service
  if unit_exists hyyper-node; then systemctl restart hyyper-node.service; fi
  if unit_exists hyyper-forwarder; then systemctl restart hyyper-forwarder.service; fi
  say "Portal ist jetzt auf $(installed_version)."
}

update_node() {
  local url tok; url=$(node_env HYY_PORTAL_URL); tok=$(node_env HYY_NODE_TOKEN)
  [[ -n "$url" && -n "$tok" ]] || die "Keine Node-Konfiguration gefunden ($NODE_ENV_DIR/node.env)."
  require_secure "$url"
  say "Aktualisiere Node (bisher $(installed_version)) …"
  fetch_node_binary "$url" "$tok"
  local tmp; tmp=$(mktemp); curl -fsSL "$url/get-hyypervisor" -o "$tmp" && install_script_file "$tmp" || say "Hinweis: Skript nicht aktualisiert (Prüfung fehlgeschlagen)."; rm -f "$tmp"
  systemctl restart hyyper-node.service
  say "Node ist jetzt auf $(installed_version)."
}

update_forwarder() {
  local url tok; url=$(fwd_env HYY_PORTAL_URL); tok=$(fwd_env HYY_FORWARDER_TOKEN)
  [[ -n "$url" && -n "$tok" ]] || die "Keine Forwarder-Konfiguration gefunden ($FWD_ENV_DIR/forwarder.env)."
  require_secure "$url"
  say "Aktualisiere Forwarder (bisher $(installed_version)) …"
  fetch_node_binary "$url" "$tok"
  local tmp; tmp=$(mktemp); curl -fsSL "$url/get-hyypervisor" -o "$tmp" && install_script_file "$tmp" || say "Hinweis: Skript nicht aktualisiert (Prüfung fehlgeschlagen)."; rm -f "$tmp"
  systemctl restart hyyper-forwarder.service
  say "Forwarder ist jetzt auf $(installed_version)."
}

uninstall_comp() {
  case "$1" in
    portal)
      systemctl disable --now hyypervisor.service 2>/dev/null || true
      rm -f /etc/systemd/system/hyypervisor.service; systemctl daemon-reload
      say "Portal-Dienst entfernt. Daten bleiben unter $PORTAL_DATA, Konfiguration unter $PORTAL_ENV_DIR." ;;
    node)
      systemctl disable --now hyyper-node.service hyyper-firewall.service 2>/dev/null || true
      rm -f /etc/systemd/system/hyyper-node.service /etc/systemd/system/hyyper-firewall.service
      nft delete table inet hyyper 2>/dev/null || true; systemctl daemon-reload
      say "Node-Dienst entfernt. Serverdaten bleiben unter $(node_env HYY_NODE_DATA || echo "$NODE_DEFAULT_DATA"). Löschen: rm -rf <Ordner>; Benutzer: userdel $NODE_USER" ;;
    forwarder)
      systemctl disable --now hyyper-forwarder.service 2>/dev/null || true
      rm -f /etc/systemd/system/hyyper-forwarder.service
      nft delete table ip hyyper_fwd 2>/dev/null || true; systemctl daemon-reload
      say "Forwarder-Dienst entfernt, Weiterleitungsregeln gelöscht. Konfiguration: $FWD_ENV_DIR, Daten: $FWD_DATA (bleiben). Benutzer: userdel $FWD_USER" ;;
    *) die "Bauteil angeben: portal | node | forwarder" ;;
  esac
}

set_backup_dir() {
  unit_exists hyyper-node || die "Hier ist kein hyyper-node installiert."
  [[ -n "$BACKUP_DIR" ]] || die "Aufruf: get-hyypervisor backup-dir <Ordner|off>   (aktuell: $(node_env HYY_NODE_BACKUP_DIR || true))"
  local data uid new=""
  data=$(node_env HYY_NODE_DATA); uid=$(id -u "$NODE_USER")
  [[ -n "$data" ]] || die "Keine Node-Konfiguration gefunden ($NODE_ENV_DIR/node.env)."
  if [[ "$BACKUP_DIR" != off ]]; then check_backup_dir "$BACKUP_DIR"; new="$BACKUP_DIR"; fi
  sed -i '/^HYY_NODE_BACKUP_DIR=/d' "$NODE_ENV_DIR/node.env"
  [[ -z "$new" ]] || printf 'HYY_NODE_BACKUP_DIR=%s\n' "$new" >> "$NODE_ENV_DIR/node.env"
  sed -i "s#^ReadWritePaths=.*#ReadWritePaths=$data /run/user/$uid${new:+ $new}#" /etc/systemd/system/hyyper-node.service
  systemctl daemon-reload; systemctl restart hyyper-node.service
  if [[ -n "$new" ]]; then say "Fremdspeicher gesetzt: $new. Neue Snapshots werden dorthin kopiert (bestehende nicht automatisch)."; else say "Fremdspeicher abgeschaltet. Vorhandene Kopien bleiben liegen."; fi
}

status() {
  printf '  %-18s %s\n' "get-hyypervisor" "$([[ -x $SELF ]] && echo installiert || echo 'nicht auf dieser VM')"
  printf '  %-18s %s\n' "Binary" "$(installed_version)"
  local c
  for c in hyypervisor hyyper-node hyyper-forwarder; do
    if unit_exists "$c"; then printf '  %-18s %s\n' "$c" "$(systemctl is-active "$c" 2>/dev/null || true)"; fi
  done
  if unit_exists hyyper-node; then printf '  %-18s %s\n' "Fremdspeicher" "$(v=$(node_env HYY_NODE_BACKUP_DIR); echo "${v:-aus}")"; fi
}

# ---- Ablauf ----------------------------------------------------------------------------------------------
[[ -n "$ACTION" ]] || menu
case "$ACTION" in
  status) status; exit 0 ;;
  backup-dir) set_backup_dir; exit 0 ;;
  uninstall) uninstall_comp "${COMP:-}"; exit 0 ;;
  update)
    done_any=0
    if [[ -z "$COMP" || "$COMP" == portal || "$COMP" == all ]] && unit_exists hyypervisor; then update_portal; done_any=1; fi
    if [[ -z "$COMP" || "$COMP" == node || "$COMP" == all ]] && unit_exists hyyper-node; then
      # Auf einer VM mit Portal hat update_portal das gemeinsame Binary schon erneuert.
      if ! unit_exists hyypervisor; then update_node; fi; done_any=1
    fi
    if [[ -z "$COMP" || "$COMP" == forwarder || "$COMP" == all ]] && unit_exists hyyper-forwarder; then
      if ! unit_exists hyypervisor && ! unit_exists hyyper-node; then update_forwarder; fi; done_any=1
    fi
    [[ $done_any -eq 1 ]] || die "Hier ist nichts zum Aktualisieren installiert."
    exit 0 ;;
  install) ;;
  *) die "Unbekannte Aktion: $ACTION" ;;
esac

[[ ${#COMPS[@]} -gt 0 ]] || menu
install_self

# Auswahl prüfen: doppelte Angaben sind egal, das Portal kommt immer zuerst.
WANT_PORTAL=0; WANT_NODE=0; WANT_FWD=0
for c in "${COMPS[@]}"; do
  case "$c" in
    portal) WANT_PORTAL=1 ;;
    node) WANT_NODE=1 ;;
    forwarder) WANT_FWD=1 ;;
    *) die "Unbekanntes Bauteil: $c (portal, node oder forwarder)" ;;
  esac
done
FOLLOW=()
if [[ $WANT_NODE -eq 1 ]]; then FOLLOW+=(node); fi
if [[ $WANT_FWD -eq 1 ]]; then FOLLOW+=(forwarder); fi
if [[ -n "$TOKEN" && $WANT_PORTAL -eq 1 ]]; then die "Beim Portal gibt es keinen Token: --token gehört zu Node/Forwarder (aus dem Portal, nachdem es läuft)."; fi
if [[ -n "$TOKEN" && ${#FOLLOW[@]} -gt 1 ]]; then die "--token gilt nur für ein Bauteil. Node und Forwarder brauchen je einen eigenen Token: ohne --token starten, das Skript fragt dann nacheinander."; fi

# Nach dem Portal: Einrichtung im Browser, dann Token für die weiteren Bauteile abfragen (Enter = später).
follow_up_after_portal() {
  PORTAL_URL="http://127.0.0.1:${PORTAL_LOCAL_PORT:-8080}"
  local ip c n=3 t label
  ip=$(hostname -I 2>/dev/null | awk '{print $1}') || true
  printf '\nDas Portal läuft. Jetzt im Browser einrichten, danach geht es hier weiter:\n'
  printf '  1. http://%s:%s öffnen und den Assistenten mit dem Setup-Code durchlaufen.\n' "${ip:-<VM-IP>}" "${PORTAL_LOCAL_PORT:-8080}"
  printf '  2. Einstellungen → Allgemein: "Spieleradresse" eintragen.\n'
  for c in "${FOLLOW[@]}"; do
    if [[ "$c" == node ]]; then printf '  %s. Nodes → Node anlegen (Name, Portbereich), Beitritts-Token kopieren.\n' "$n"
    else printf '  %s. Forwarder → Forwarder anlegen, Beitritts-Token kopieren.\n' "$n"; fi
    n=$((n + 1))
  done
  printf '\n'
  for c in "${FOLLOW[@]}"; do
    TOKEN=""
    if [[ "$c" == node ]]; then label="hyyper-node"; else label="hyyper-forwarder"; fi
    t=""
    if (exec </dev/tty) 2>/dev/null; then
      read -r -s -p "  Beitritts-Token für $label (Enter = später): " t </dev/tty || true
      echo
    fi
    if [[ -n "$t" ]]; then
      TOKEN="$t"
      "install_$c"
    else
      say "Später installieren: sudo get-hyypervisor install $c --portal $PORTAL_URL   (Token wird abgefragt)"
    fi
  done
}

if [[ $WANT_PORTAL -eq 1 ]]; then
  install_portal
  if [[ ${#FOLLOW[@]} -gt 0 ]]; then
    follow_up_after_portal
  else
    cat <<EOF

Weitere VMs (Gameserver-Hosts): Admin → Nodes → "Node anlegen", dort steht der Befehl:
  curl -fsSL http://<portal>/get-hyypervisor | sudo bash -s -- install node --token <TOKEN>
Später aktualisieren: sudo get-hyypervisor update
EOF
  fi
else
  first=1
  for c in "${FOLLOW[@]}"; do
    if [[ $first -eq 0 ]]; then TOKEN=""; fi   # jedes Bauteil braucht einen eigenen Token
    first=0
    "install_$c"
  done
fi

# Lief das Skript nur im Speicher (bash <(curl …)), ist es jetzt noch nicht auf der VM: aus dem installierten Binary ablegen,
# damit "get-hyypervisor update" funktioniert.
if [[ ! -x "$SELF" ]]; then refresh_self_from_binary; fi
if [[ -x "$SELF" ]]; then say "Verwaltung später mit: sudo get-hyypervisor (update, status, uninstall …)"; fi
